# Required for admin protection
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Runtime storage mode (`supabase` for hosted, `local` for local fallback)
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional private affiliate-review volume. Defaults to
# ./output/affiliate-pilot/v4 and is read only by authenticated server routes.
AFFILIATE_PILOT_V4_OUTPUT_ROOT=

# Owner-review media source. Use `filesystem` locally. After running the private
# hosted import, set this to `supabase` in the hosted server environment.
AFFILIATE_OWNER_REVIEW_SOURCE=filesystem
AFFILIATE_REVIEW_MEDIA_BUCKET=affiliate-owner-review

# Optional: Klaviyo integration
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# Optional: verified site base URL for canonical links. Keep this on the
# production Vercel alias until a custom domain is attached and its DNS/TLS pass.
NEXT_PUBLIC_SITE_URL=https://projectpint.vercel.app
